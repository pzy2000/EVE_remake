{
  "ok": true,
  "data": {
    "_meta": {
      "access_tokens": [],
      "affordance": {
        "use_when": [
          "Save explicit store-information changes after inspecting the current draft and confirming the exact fields to update."
        ],
        "avoid_when": [
          "You only need to inspect current readiness → use `analyze-app-status`",
          "You are changing the selected package rather than store fields → use `select-package`"
        ],
        "prerequisites": [
          "Current draft state from `analyze-app-status` or `get-app-module`",
          "An idempotency key and explicit user-approved field values"
        ],
        "examples": [
          {
            "description": "Preview exact changes",
            "command": "taptap-cli app save-changes --dev-id \"\u003cdeveloper_id\u003e\" --app-id \"\u003capp_id\u003e\" --data @changes.json --idempotency-key \"\u003ckey\u003e\" --dry-run"
          }
        ],
        "skills": [
          "taptap-app-edit/references/app-edit-fields-and-packages.md"
        ]
      },
      "danger": true,
      "envelope_version": "1.0",
      "required_scopes": [],
      "risk": "write",
      "scopes": []
    },
    "description": "保存 App 资料编辑草稿。支持逐字段写入、数组追加/替换/删除，调用方需先读取当前值以执行 read-before-write 校验。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "description": "App 全局稳定 ID。",
          "maxLength": 16,
          "minLength": 1,
          "pattern": "^[1-9]\\d*$",
          "type": "string"
        },
        "changes": {
          "items": {
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "expected"
                ]
              },
              {
                "required": [
                  "expected_digest"
                ]
              },
              {
                "properties": {
                  "force": {
                    "const": true
                  }
                },
                "required": [
                  "force"
                ]
              }
            ],
            "properties": {
              "expected": {},
              "expected_digest": {
                "pattern": "^sha256:[a-f0-9]{64}$",
                "type": "string"
              },
              "field_id": {
                "minLength": 1,
                "type": "string"
              },
              "force": {
                "type": "boolean"
              },
              "old_value": {
                "type": "string"
              },
              "op": {
                "enum": [
                  "append",
                  "replace",
                  "remove",
                  "replace_one"
                ],
                "type": "string"
              },
              "value": {}
            },
            "required": [
              "field_id",
              "value"
            ],
            "type": "object"
          },
          "maxItems": 200,
          "minItems": 1,
          "type": "array"
        },
        "developer_id": {
          "description": "Developer 全局稳定 ID。",
          "maxLength": 16,
          "minLength": 1,
          "pattern": "^[1-9]\\d*$",
          "type": "string"
        }
      },
      "required": [
        "app_id",
        "changes",
        "developer_id"
      ],
      "type": "object"
    },
    "name": "app save-changes",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "result": {
          "additionalProperties": false,
          "example": {
            "revision": 1,
            "stale": [
              {}
            ],
            "updated_fields": [
              {}
            ],
            "version_id": "example"
          },
          "properties": {
            "revision": {
              "description": "保存后的草稿版本 ID 数字形式，保存草稿内容不会改变。",
              "type": "integer"
            },
            "stale": {
              "description": "因写入顺序导致与当前草稿事实冲突的字段列表，需要重新读取后再次保存。",
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            "updated_fields": {
              "description": "本次保存实际修改的字段 ID 列表。",
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            "version_id": {
              "description": "当前草稿的版本 ID。",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "version_id",
            "revision",
            "updated_fields",
            "stale"
          ],
          "type": "object"
        },
        "status": {
          "const": "completed",
          "type": "string"
        }
      },
      "required": [
        "status",
        "result"
      ],
      "type": "object"
    }
  },
