.main-menu {
    align-items: center;
    justify-content: center;
    background-color: rgba(1, 4, 13, 0.16);
}

.menu-glow {
    position: absolute;
    left: 4%;
    right: 4%;
    top: 6%;
    bottom: 6%;
    background-color: rgba(3, 17, 35, 0.20);
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: rgba(82, 224, 255, 0.28);
    border-right-color: rgba(82, 224, 255, 0.28);
    border-top-left-radius: 34px;
    border-top-right-radius: 34px;
    border-bottom-left-radius: 34px;
    border-bottom-right-radius: 34px;
}

.menu-card {
    width: 720px;
    padding: 28px;
    background-color: rgba(3, 12, 29, 0.91);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(82, 224, 255, 0.62);
    border-bottom-color: rgba(82, 224, 255, 0.34);
    border-left-color: rgba(82, 224, 255, 0.34);
    border-right-color: rgba(82, 224, 255, 0.34);
}
.subtitle { font-size: 18px; margin-top: -8px; margin-bottom: 10px; }
.section-title { margin-top: 16px; margin-bottom: 7px; }
.empire-grid { flex-direction: row; }
.empire-card { flex-grow: 1; height: 76px; margin-right: 6px; white-space: normal; }
.aurelian { border-top-color: rgb(245, 184, 65); }
.kaldari { border-top-color: rgb(67, 145, 244); }
.meridian { border-top-color: rgb(67, 224, 185); }
.varkhald { border-top-color: rgb(225, 103, 58); }
.description { min-height: 34px; margin-top: 8px; }
.primary { height: 44px; font-size: 18px; letter-spacing: 2px; }
.button-row { flex-direction: row; margin-top: 8px; }
.button-row Button { flex-grow: 1; margin-right: 6px; }
.footer { margin-top: 12px; -unity-text-align: middle-center; font-size: 11px; }
