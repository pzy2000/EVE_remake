<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/Starfall/UI/StarfallTheme.uss" />
    <ui:Style src="project://database/Assets/Starfall/UI/SpaceHud.uss" />
    <ui:Style src="project://database/Assets/Starfall/UI/StarfallMobile.uss" />
    <ui:VisualElement name="space-hud" class="screen hud">
        <ui:VisualElement class="topbar panel">
            <ui:VisualElement name="topbar-left" class="topbar-left">
                <ui:Label name="system-name" text="HELIOS PRIME" class="title system-title" />
                <ui:Label name="security" text="SEC 1.0" class="security" />
                <ui:Label name="mission" text="No active mission" class="mission muted" />
            </ui:VisualElement>
            <ui:VisualElement name="topbar-gap" class="topbar-gap" />
            <ui:VisualElement name="topbar-right" class="topbar-right">
                <ui:Button name="map" text="MAP [M]" />
                <ui:Button name="journal" text="JOURNAL [J]" />
                <ui:Button name="pilot" text="PILOT [C]" />
                <ui:Button name="save" text="SAVE" />
                <ui:Button name="settings" text="⚙" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="mobile-panel-controls" class="mobile-panel-controls">
            <ui:Button name="mobile-overview-toggle" text="OVERVIEW" />
            <ui:Button name="mobile-target-toggle" text="TARGET" />
            <ui:Button name="mobile-log-toggle" text="LOG" />
        </ui:VisualElement>
        <ui:VisualElement name="overview-panel" class="overview panel">
            <ui:VisualElement class="overview-heading">
                <ui:Label text="OVERVIEW" class="eyebrow overview-title" />
                <ui:Label name="overview-count" text="0 CONTACTS" class="overview-count" />
            </ui:VisualElement>
            <ui:VisualElement class="overview-tabs">
                <ui:Button name="overview-tab-general" text="GENERAL" />
                <ui:Button name="overview-tab-combat" text="COMBAT" />
                <ui:Button name="overview-tab-mining" text="MINING" />
                <ui:Button name="overview-tab-travel" text="TRAVEL" />
                <ui:Button name="overview-tab-all" text="ALL" class="overview-tab-last" />
            </ui:VisualElement>
            <ui:VisualElement class="overview-columns">
                <ui:Button name="overview-sort-threat" text="!" tooltip="Sort by threat priority" class="overview-column overview-column-state" />
                <ui:Button name="overview-sort-distance" text="DIST" tooltip="Sort by distance" class="overview-column overview-column-distance" />
                <ui:Button name="overview-sort-name" text="NAME" tooltip="Sort by name" class="overview-column overview-column-name" />
                <ui:Button name="overview-sort-type" text="TYPE" tooltip="Sort by object type" class="overview-column overview-column-type" />
                <ui:Button name="overview-sort-velocity" text="SPEED" tooltip="Sort by velocity" class="overview-column overview-column-velocity" />
            </ui:VisualElement>
            <ui:ListView name="overview-list" class="overview-list" />
            <ui:Label name="overview-empty" text="NO CONTACTS MATCH THIS FILTER" class="overview-empty" />
        </ui:VisualElement>
        <ui:VisualElement name="target-panel" class="target panel">
            <ui:Label text="SELECTED OBJECT" class="eyebrow" />
            <ui:Label name="target-name" text="No target" class="target-name" />
            <ui:Label name="target-detail" text="Select an object in space" class="muted" />
            <ui:VisualElement class="button-row">
                <ui:Button name="approach" text="APPROACH" />
                <ui:Button name="orbit" text="ORBIT" />
                <ui:Button name="warp" text="WARP [W]" />
            </ui:VisualElement>
            <ui:VisualElement class="button-row">
                <ui:Button name="lock" text="LOCK [L]" />
                <ui:Button name="dock" text="DOCK/JUMP [D]" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ship-status" class="ship-status panel">
            <ui:Label name="pilot-name" text="Pilot" class="eyebrow" />
            <ui:Label name="ship-name" text="Acolyte · Frigate" />
            <ui:Label name="credits" text="50,000 ISK" class="muted" />
            <ui:Label name="speed" text="0 m/s" class="muted" />
            <ui:VisualElement class="bar-track"><ui:VisualElement name="shield" class="bar-fill shield" /></ui:VisualElement>
            <ui:VisualElement class="bar-track"><ui:VisualElement name="armor" class="bar-fill armor" /></ui:VisualElement>
            <ui:VisualElement class="bar-track"><ui:VisualElement name="hull" class="bar-fill hull" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:ScrollView name="module-rack" class="module-rack panel">
            <ui:Button name="module-1" text="1&#10;—" />
            <ui:Button name="module-2" text="2&#10;—" />
            <ui:Button name="module-3" text="3&#10;—" />
            <ui:Button name="module-4" text="4&#10;—" />
            <ui:Button name="module-5" text="5&#10;—" />
            <ui:Button name="module-6" text="6&#10;—" />
            <ui:Button name="module-7" text="7&#10;—" />
            <ui:Button name="module-8" text="8&#10;—" />
            <ui:Button name="module-9" text="9&#10;—" />
        </ui:ScrollView>
        <ui:ScrollView name="combat-log-scroll" class="combat-log panel">
            <ui:Label name="combat-log" text="Welcome to the stars." />
        </ui:ScrollView>
        <ui:VisualElement name="map-overlay" class="screen modal-overlay">
            <ui:VisualElement name="starmap-card" class="panel modal-card starmap-card">
                <ui:VisualElement class="modal-header">
                    <ui:Label text="GALACTIC STARMAP" class="title modal-title" />
                    <ui:Button name="map-close" text="CLOSE [M]" />
                </ui:VisualElement>
                <ui:Label text="48 deterministic systems · click a system to set the shortest route" class="muted" />
                <ui:ScrollView name="starmap-list" class="modal-list" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="journal-overlay" class="screen modal-overlay">
            <ui:VisualElement name="journal-card" class="panel modal-card">
                <ui:VisualElement class="modal-header">
                    <ui:Label text="MISSION JOURNAL" class="title modal-title" />
                    <ui:Button name="journal-close" text="CLOSE [J]" />
                </ui:VisualElement>
                <ui:Label text="Security · Distribution · Mining · Storyline" class="muted" />
                <ui:ScrollView name="journal-list" class="modal-list" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="death-overlay" class="screen death-overlay">
            <ui:VisualElement name="death-card" class="panel death-card">
                <ui:Label text="VESSEL DESTROYED" class="title danger" />
                <ui:Label text="Your clone contract is active at your home station." />
                <ui:Button name="respawn" text="ACTIVATE CLONE" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
