.topbar { position: absolute; left: 16px; right: 16px; top: 12px; height: 52px; flex-direction: row; align-items: center; }
.system-title { font-size: 19px; width: 250px; -unity-text-align: middle-left; }
.security { color: rgb(89, 238, 133); width: 72px; }
.mission { flex-grow: 1; }
.topbar Button { margin-left: 5px; min-width: 82px; }
.topbar #settings { min-width: 96px; }
.overview {
    position: absolute;
    left: 16px;
    top: 78px;
    width: 28%;
    min-width: 410px;
    max-width: 520px;
    bottom: 230px;
    padding: 8px;
}
.overview-heading { height: 24px; flex-direction: row; align-items: center; }
.overview-title { flex-grow: 1; }
.overview-count { color: rgb(128, 177, 199); font-size: 12px; letter-spacing: 1px; }
.overview-tabs { height: 33px; flex-direction: row; margin-top: 4px; }
.overview-tabs Button {
    min-width: 0;
    min-height: 40px;
    height: 40px;
    flex-grow: 1;
    margin-right: 3px;
    padding-left: 2px;
    padding-right: 2px;
    font-size: 12px;
    letter-spacing: 1px;
}
.overview-tabs .overview-tab-last { margin-right: 0; }
.overview-tabs Button.chosen {
    background-color: rgba(26, 116, 151, 0.9);
    border-bottom-color: rgb(88, 224, 255);
    border-bottom-width: 2px;
    color: white;
}
.overview-columns {
    height: 38px;
    flex-direction: row;
    align-items: stretch;
    margin-top: 1px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(72, 173, 211, 0.34);
    background-color: rgba(2, 10, 23, 0.78);
}
.overview-column {
    min-width: 0;
    min-height: 36px;
    height: 36px;
    margin: 0;
    padding-left: 4px;
    padding-right: 4px;
    background-color: rgba(3, 13, 28, 0.9);
    border-left-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-right-width: 1px;
    border-right-color: rgba(72, 173, 211, 0.22);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    color: rgb(112, 159, 182);
    font-size: 12px;
    -unity-text-align: middle-left;
}
.overview-column:hover, .overview-column.sorted {
    background-color: rgba(20, 73, 99, 0.72);
    color: rgb(210, 244, 255);
}
.overview-column-state { width: 44px; -unity-text-align: middle-center; }
.overview-column-distance { width: 84px; -unity-text-align: middle-right; }
.overview-column-name { flex-grow: 1; min-width: 92px; }
.overview-column-type { width: 96px; }
.overview-column-velocity { width: 84px; -unity-text-align: middle-right; }
.overview-list {
    flex-grow: 1;
    margin-top: 1px;
    background-color: rgba(1, 7, 17, 0.54);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.overview-list .unity-scroll-view__content-container { flex-grow: 1; }
.overview-list .unity-collection-view__item { padding: 0; }
.overview-list .unity-collection-view__item--selected { background-color: transparent; }
.overview-row {
    height: 40px;
    flex-direction: row;
    align-items: stretch;
    border-bottom-width: 1px;
    border-bottom-color: rgba(66, 133, 159, 0.13);
    background-color: rgba(4, 13, 27, 0.5);
}
.overview-row:hover { background-color: rgba(25, 65, 85, 0.76); }
.overview-row.selected {
    background-color: rgba(12, 72, 101, 0.82);
    border-left-width: 2px;
    border-left-color: rgb(70, 220, 255);
}
.overview-row.hostile { background-color: rgba(61, 13, 20, 0.55); }
.overview-row.hostile:hover { background-color: rgba(94, 22, 31, 0.76); }
.overview-row.attacking {
    background-color: rgba(102, 13, 24, 0.76);
    border-left-width: 2px;
    border-left-color: rgb(255, 62, 70);
}
.overview-row.attacking.selected {
    border-right-width: 2px;
    border-right-color: rgb(70, 220, 255);
}
.overview-row.mission { border-bottom-color: rgba(255, 184, 66, 0.55); }
.overview-row.stale { opacity: 0.4; }
.overview-cell {
    height: 40px;
    padding-left: 4px;
    padding-right: 4px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
    font-size: 14px;
}
.overview-state-cell { width: 48px; flex-direction: row; align-items: center; padding-left: 3px; padding-right: 1px; }
.overview-object-icon { width: 22px; height: 22px; flex-shrink: 0; }
.overview-badges { flex-grow: 1; color: rgb(255, 205, 92); font-size: 11px; -unity-text-align: middle-center; }
.overview-distance { width: 84px; color: rgb(178, 211, 226); -unity-text-align: middle-right; }
.overview-name { flex-grow: 1; min-width: 92px; color: rgb(220, 238, 246); }
.overview-type { width: 96px; color: rgb(125, 170, 191); }
.overview-velocity { width: 84px; color: rgb(150, 190, 207); -unity-text-align: middle-right; }
.overview-empty {
    display: none;
    position: absolute;
    left: 8px;
    right: 8px;
    top: 118px;
    color: rgb(88, 124, 144);
    font-size: 13px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}
.modal-list-row { -unity-text-align: middle-left; margin-bottom: 3px; }
.target { position: absolute; right: 16px; top: 78px; width: 315px; }
.target-name { color: var(--cyan); font-size: 21px; margin-top: 5px; }
.button-row { flex-direction: row; margin-top: 7px; }
.button-row Button { flex-grow: 1; margin-right: 4px; }
.ship-status { position: absolute; left: 16px; bottom: 16px; width: 250px; }
.module-rack { position: absolute; left: 285px; right: 370px; bottom: 16px; height: 83px; flex-direction: row; justify-content: center; }
.module-rack Button { width: 78px; margin-right: 4px; white-space: normal; font-size: 13px; }
.module-rack Button.active { background-color: rgb(144, 73, 27); border-top-color: rgb(255, 181, 72); }
.combat-log { position: absolute; right: 16px; bottom: 16px; width: 335px; min-height: 112px; color: rgb(170, 211, 229); font-size: 14px; }
.modal-overlay { display: none; background-color: rgba(0, 3, 12, 0.78); align-items: center; justify-content: center; }
.modal-card { width: 700px; height: 610px; max-width: 96%; max-height: 88%; padding: 18px; }
.starmap-card { width: 920px; max-width: 96%; }
.modal-header { flex-direction: row; align-items: center; }
.modal-header Button { width: 112px; }
.modal-title { flex-grow: 1; font-size: 23px; -unity-text-align: middle-left; }
.modal-list { flex-grow: 1; margin-top: 12px; }
.modal-list Button { min-height: 36px; margin-bottom: 3px; -unity-text-align: middle-left; }
.death-overlay { display: none; background-color: rgba(20, 0, 3, 0.78); align-items: center; justify-content: center; }
.death-card { width: 470px; align-items: center; }
.death-card Button { width: 220px; margin-top: 16px; }

/* ---- slim scrollbars (all layouts) ---- */
.overview-list .unity-scroller--vertical,
.modal-list .unity-scroller--vertical { width: 8px; }
.overview-list .unity-scroller__low-button,
.overview-list .unity-scroller__high-button,
.modal-list .unity-scroller__low-button,
.modal-list .unity-scroller__high-button { display: none; }
.overview-list .unity-scroller--vertical .unity-base-slider__tracker,
.modal-list .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(1, 5, 12, 0.45);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.overview-list .unity-scroller--vertical .unity-base-slider__dragger,
.modal-list .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(67, 190, 235, 0.5);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

/* ---- compact layout: foldable / small screens (class toggled by StarfallResponsiveUi) ---- */
/* topbar keeps a 132px right inset so the WeChat webview capsule cannot cover the buttons */
.hud-compact .topbar { left: 10px; right: 10px; top: 8px; height: 52px; }
.hud-compact .system-title { font-size: 16px; width: 168px; }
.hud-compact .security { width: 60px; font-size: 13px; }
.hud-compact .mission { font-size: 13px; }
.hud-compact .topbar Button { min-width: 56px; min-height: 44px; margin-left: 4px; padding-left: 8px; padding-right: 8px; font-size: 12px; }
.hud-compact .topbar #settings { min-width: 60px; padding-left: 4px; padding-right: 4px; font-size: 11px; letter-spacing: 0; }
.hud-compact .overview { left: 10px; top: 58px; width: 24%; min-width: 286px; max-width: 372px; bottom: 292px; padding: 6px; }
.hud-compact .overview-heading { height: 20px; }
.hud-compact .overview-count { font-size: 10px; }
.hud-compact .overview-tabs { height: 25px; margin-top: 3px; }
.hud-compact .overview-tabs Button { min-height: 40px; height: 40px; font-size: 11px; margin-right: 2px; }
.hud-compact .overview-columns { height: 38px; }
.hud-compact .overview-column { min-height: 36px; height: 36px; font-size: 11px; }
.hud-compact .overview-column-state { width: 28px; }
.hud-compact .overview-column-distance { width: 66px; }
.hud-compact .overview-column-name { min-width: 60px; }
.hud-compact .overview-column-type { width: 64px; }
.hud-compact .overview-column-velocity { width: 70px; }
.hud-compact .overview-row { height: 34px; }
.hud-compact .overview-cell { height: 34px; font-size: 13px; }
.hud-compact .overview-state-cell { width: 30px; }
.hud-compact .overview-object-icon { width: 16px; height: 16px; }
.hud-compact .overview-badges { font-size: 10px; }
.hud-compact .overview-distance { width: 66px; }
.hud-compact .overview-type { width: 64px; }
.hud-compact .overview-velocity { width: 70px; }
.hud-compact .overview-empty { top: 102px; font-size: 12px; }
.hud-compact .target { right: 10px; top: 58px; width: 238px; padding: 8px; }
.hud-compact .target-name { font-size: 17px; margin-top: 3px; }
.hud-compact .target .muted { font-size: 12px; }
.hud-compact .button-row { margin-top: 5px; }
.hud-compact .button-row Button { min-height: 44px; font-size: 11px; }
.hud-compact .ship-status { left: 10px; bottom: 10px; width: 206px; padding: 8px; }
.hud-compact .ship-status Label { font-size: 13px; }
.hud-compact .ship-status .eyebrow { font-size: 11px; }
.hud-compact .bar-track { height: 7px; margin-top: 3px; }
.hud-compact .bar-fill { height: 7px; }
/* Ultra-narrow compact (portrait phones, panel space < ~1000): the module rack
   leaves the squeezed bottom row and becomes its own full-width row above the
   pilot/log panels, and buttons flex instead of spilling over the neighbours. */
.hud-compact .module-rack { left: 10px; right: 10px; bottom: 206px; height: 76px; padding-left: 4px; padding-right: 4px; }
.hud-compact .module-rack Button {
    width: auto;
    min-width: 44px;
    max-width: 60px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 3px;
    font-size: 11px;
    min-height: 48px;
}
.hud-compact .combat-log { right: 10px; bottom: 10px; width: 254px; min-height: 76px; font-size: 12px; padding: 8px; }
.hud-compact .modal-card { width: 94%; height: auto; max-height: 90%; padding: 12px; }
.hud-compact .modal-title { font-size: 18px; }
.hud-compact .modal-header Button { width: 96px; min-height: 44px; }
.hud-compact .modal-list Button { min-height: 44px; }
.hud-compact .death-card { width: 400px; }
.hud-compact .death-card Button { width: 200px; }
