.topbar-left,
.topbar-right,
.station-header-actions {
    flex-direction: row;
    align-items: center;
}

.topbar-left { flex-grow: 1; }
.topbar-right { justify-content: flex-end; }
.topbar-gap,
.station-header-spacer { flex-grow: 1; }
.mobile-panel-controls { display: none; }

.mobile Button,
.mobile TextField,
.mobile Slider,
.mobile Toggle {
    min-height: 48px;
}

.mobile Button { min-width: 48px; }
/* ScrollView handles support the viewport's swipe gesture; they are not game
   action buttons. Do not expand their internal sliders to the 48dp action size. */
.mobile .unity-scroller Slider { min-height: 12px; min-width: 12px; }
.mobile .unity-scroller Button {
    min-height: 12px;
    min-width: 12px;
    width: 12px;
    height: 12px;
    margin: 0;
    padding: 0;
}
.mobile .unity-scroller--horizontal { height: 12px; }
.mobile .unity-scroller--vertical { width: 12px; }
.mobile .service-row { min-height: 48px; }
.mobile .modal-list Button { min-height: 48px; }
.mobile .settings-card { max-height: 90%; }
.mobile .eyebrow,
.mobile .overview-count,
.mobile .overview-tabs Button,
.mobile .overview-column,
.mobile .overview-empty,
.mobile .module-rack Button,
.mobile .legacy-import-status,
.mobile .route,
.mobile .cargo,
.mobile .target-health-row Label,
.mobile .progression-summary,
.mobile .service-detail,
.mobile .station-status,
.mobile .onboarding-summary,
.mobile .mission-offer-detail,
.mobile .mission-list-detail,
.mobile #settings-display-heading,
.mobile #settings-audio-heading,
.mobile #settings-footer {
    font-size: 14px;
}

.mobile .overview-badges,
.mobile .station-footer,
.mobile .footer {
    font-size: 14px;
}

.mobile .overview-tabs { height: 49px; }
.mobile .overview-tabs Button {
    min-height: 48px;
    height: 48px;
}

.mobile .overview-columns { height: 49px; }
.mobile .overview-column {
    min-height: 48px;
    height: 48px;
}

.mobile .overview-row,
.mobile .overview-cell { height: 48px; }
.mobile .overview-object-icon { width: 30px; height: 30px; }

/* Keep intrinsic content out of Yoga's shrinking rows. On short windows the
   menu scrolls as a whole instead of pushing labels through the touch targets. */
.mobile .menu-card { height: 96%; max-height: 580px; }
.mobile .mobile-menu-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; min-width: 0; }
.mobile .mobile-menu-scroll .unity-scroll-view__content-container {
    width: 100%;
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}
.mobile .mobile-menu-scroll .unity-scroll-view__content-container > * { flex-shrink: 0; }
.mobile .menu-card .empire-grid { min-height: 58px; }
.mobile .menu-card .button-row { min-height: 48px; flex-shrink: 0; }
.mobile .empire-card { min-width: 0; flex-basis: 0; }
.mobile.hinge-vertical .empire-card { flex-basis: auto; }
.mobile .description { white-space: normal; }
.mobile .continue-summary { white-space: normal; margin-top: 4px; }
.mobile .overview-heading,
.mobile .overview-tabs,
.mobile .overview-columns { flex-shrink: 0; }
.mobile .overview-list { min-height: 48px; }

.mobile.compact-landscape .menu-card {
    width: 96%;
    max-width: 980px;
    padding: 8px;
}

.mobile.compact-landscape .menu-card .title { font-size: 27px; }
.mobile.compact-landscape .menu-card .subtitle { font-size: 16px; margin-bottom: 3px; }
.mobile.compact-landscape .menu-card .section-title { margin-top: 5px; margin-bottom: 3px; }
.mobile.compact-landscape .empire-card { height: 54px; }
.mobile.compact-landscape .description { min-height: 24px; margin-top: 3px; }
.mobile.compact-landscape .primary { height: 48px; }
.mobile.compact-landscape .footer { display: none; }
.mobile.compact-landscape .menu-tagline { display: none; }

.mobile.square-expanded .menu-card {
    width: 96%;
    max-width: 720px;
}

.mobile.square-expanded .station-header-actions {
    flex-shrink: 1;
}

.mobile.square-expanded .station-header-actions Button {
    width: auto;
    min-width: 48px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 4px;
}

.mobile.compact-landscape .station-header {
    left: 4px;
    right: 4px;
    top: 4px;
    height: 58px;
    padding: 5px;
}

.mobile.compact-landscape .station-title { font-size: 18px; }
.mobile.compact-landscape .station-header Button {
    width: auto;
    min-width: 76px;
    margin-left: 4px;
}

.mobile.compact-landscape .station-services {
    left: 4px;
    right: 4px;
    top: 68px;
    bottom: 4px;
    width: auto;
}

.mobile.compact-landscape .station-footer { display: none; }
.mobile.compact-landscape .tabbar { height: 49px; }
.mobile.compact-landscape .tabbar Button { min-height: 48px; }

.mobile.compact-landscape .topbar {
    left: 4px;
    right: 4px;
    top: 4px;
    height: 54px;
    padding: 5px;
}

.mobile.compact-landscape .system-title { width: 190px; font-size: 17px; }
.mobile.compact-landscape .mission { display: none; }
.mobile.compact-landscape .objective-tracker {
    left: 50%;
    right: 8px;
    top: 118px;
    width: auto;
    min-height: 48px;
    padding: 4px;
}
.mobile.compact-landscape.mobile-panel-target .objective-tracker,
.mobile.compact-landscape.mobile-panel-log .objective-tracker { display: none; }
.mobile.compact-landscape .action-toast {
    left: 464px;
    right: 8px;
    bottom: 112px;
}
.mobile.compact-landscape .topbar Button { min-width: 66px; margin-left: 3px; }
.mobile.compact-landscape .mobile-panel-controls {
    display: flex;
    position: absolute;
    right: 8px;
    top: 64px;
    height: 48px;
    flex-direction: row;
}

.mobile.compact-landscape .mobile-panel-controls Button {
    min-width: 104px;
    margin-left: 4px;
}

.mobile.compact-landscape .overview {
    display: flex;
    left: 8px;
    top: 64px;
    padding: 4px;
    bottom: 112px;
    width: 440px;
    min-width: 0;
    max-width: 48%;
}

.mobile.compact-landscape .target,
.mobile.compact-landscape .combat-log { display: none; }
.mobile.compact-landscape.mobile-panel-target .overview { display: none; }
.mobile.compact-landscape.mobile-panel-target .target {
    display: flex;
    right: 8px;
    top: 118px;
    bottom: 112px;
    width: 360px;
    padding: 4px;
}
.mobile .mobile-target-scroll { flex-grow: 1; min-height: 0; min-width: 0; }
.mobile .mobile-target-scroll .unity-scroll-view__content-container { width: 100%; min-width: 0; }
.mobile .mobile-target-scroll .unity-scroll-view__content-container > * { flex-shrink: 0; }
.mobile .mobile-target-scroll .button-row { min-height: 48px; }
.mobile.compact-landscape.mobile-panel-target .action-toast,
.mobile.compact-landscape.mobile-panel-log .action-toast {
    left: 8px;
    right: 52%;
    top: 64px;
    bottom: auto;
}
.mobile.compact-landscape.mobile-panel-log .overview { display: none; }
.mobile.compact-landscape.mobile-panel-log .combat-log {
    display: flex;
    right: 8px;
    top: 118px;
    bottom: 112px;
    width: 420px;
}

.mobile.compact-landscape .ship-status {
    left: 8px;
    bottom: 4px;
    width: 220px;
    height: 102px;
    padding: 4px;
}

/* Pilot identity and credits remain in PILOT. Reserve a fixed bottom strip
   for flight telemetry so it cannot grow over the contact list. */
.mobile.compact-landscape .ship-status #pilot-name,
.mobile.compact-landscape .ship-status #credits { display: none; }
.mobile.compact-landscape .ship-status Label {
    height: 18px;
    min-height: 18px;
    flex-shrink: 0;
    font-size: 14px;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.mobile.compact-landscape .ship-status .bar-track { height: 8px; margin-top: 3px; flex-shrink: 0; }
.mobile.compact-landscape .ship-status .bar-fill { height: 8px; }

.mobile.compact-landscape .module-rack {
    left: 236px;
    right: 8px;
    bottom: 4px;
    height: 102px;
    padding: 5px;
}

.mobile.compact-landscape .module-rack Button {
    width: 116px;
    height: 76px;
    min-height: 76px;
    flex-shrink: 0;
    margin-right: 3px;
    font-size: 14px;
}

.mobile.compact-landscape .modal-card,
.mobile.compact-landscape .starmap-card {
    width: 96%;
    /* UI Toolkit adds panel padding to the resolved box; 87% keeps the card and
       its border inside the 1172px acceptance viewport at 420 dpi. */
    height: 87%;
    padding: 10px;
}

.mobile.compact-landscape .death-card { width: 72%; }

.mobile.square-expanded .topbar {
    left: 10px;
    right: 10px;
    top: 8px;
    height: 60px;
}

.mobile.square-expanded .overview {
    left: 10px;
    top: 78px;
    bottom: 252px;
    width: 40%;
    min-width: 340px;
    max-width: 410px;
}

.mobile.square-expanded .target { right: 10px; top: 78px; width: 320px; }
.mobile.square-expanded .ship-status { left: 10px; bottom: 10px; width: 230px; height: 232px; }
.mobile.square-expanded .module-rack {
    left: 250px;
    right: 352px;
    bottom: 10px;
    height: 120px;
    padding: 6px;
}

.mobile.square-expanded .module-rack Button {
    width: 66px;
    min-height: 48px;
    flex-shrink: 0;
    margin-right: 3px;
}

.mobile.square-expanded .combat-log { right: 10px; bottom: 10px; width: 330px; height: 120px; }
.mobile.square-expanded .objective-tracker { top: 78px; left: 430px; right: 340px; }
.mobile.square-expanded .action-toast { left: 250px; right: 352px; bottom: 136px; }
.mobile.square-expanded .modal-card { width: 86%; height: 78%; }
.mobile.square-expanded .starmap-card { width: 92%; }

.mobile.hinge-vertical .mobile-panel-controls,
.mobile.hinge-horizontal .mobile-panel-controls { display: none; }

/* A vertical fold leaves two narrow portrait-like panes. Reflow empire choices so
   their intrinsic text width cannot push a touch target across the hinge. */
.mobile.hinge-vertical .menu-card { padding: 14px; }
.mobile.hinge-vertical .empire-grid { flex-wrap: wrap; }
.mobile.hinge-vertical .empire-card {
    flex-grow: 0;
    width: 47%;
    min-width: 0;
    height: 62px;
    margin-right: 4px;
    margin-bottom: 4px;
}

/* The 84px center hinge leaves about 428dp for all four Station actions at
   420dpi. Override the desktop 104px + 7px rhythm so UNDOCK cannot be clipped
   by the safe root while every action retains the global 48dp minimum. */
.mobile.hinge-vertical .station-header-actions Button {
    width: auto;
    min-width: 48px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 4px;
}

/* The left Space topbar pane cannot also fit the desktop mission summary.
   The full mission remains available in Journal without crossing the hinge. */
.mobile.hinge-vertical .mission { display: none; }
.mobile.hinge-vertical .objective-tracker {
    left: 10px;
    right: auto;
    width: 410px;
}
.mobile.hinge-vertical .overview { top: 144px; }

/* Dynamic dialogs live inside a single vertical pane. Account for their own
   padding so controls never spill into the 84px occluding hinge. */
.mobile.hinge-vertical .settings-card {
    width: 82%;
    max-width: 82%;
}
.mobile.hinge-vertical .death-card { width: 88%; }
.mobile.hinge-vertical .modal-title {
    min-width: 0;
    flex-shrink: 1;
    font-size: 19px;
}
.mobile.hinge-vertical .modal-header Button {
    width: 96px;
    min-width: 96px;
}

/* A horizontal tabletop fold leaves only ~404dp in each pane at the acceptance
   resolution. Use the compact menu rhythm so every action remains in one pane. */
.mobile.hinge-horizontal .menu-card { padding: 6px; }
.mobile.hinge-horizontal .menu-card .title { font-size: 27px; }
.mobile.hinge-horizontal .menu-card .subtitle { font-size: 16px; margin-bottom: 3px; }
.mobile.hinge-horizontal .menu-tagline { display: none; }
.mobile.hinge-horizontal .menu-card .section-title { margin-top: 0; margin-bottom: 0; }
.mobile.hinge-horizontal .empire-card { height: 52px; }
.mobile.hinge-horizontal .description { min-height: 22px; margin-top: 0; }
.mobile.hinge-horizontal .primary { height: 48px; }
.mobile.hinge-horizontal .button-row { margin-top: 4px; }
.mobile.hinge-horizontal .continue-summary { display: none; }
.mobile.hinge-horizontal .legacy-import-status { margin-top: 0; }
.mobile.hinge-horizontal .footer { display: none; }
