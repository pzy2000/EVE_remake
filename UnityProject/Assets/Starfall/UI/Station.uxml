<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/Starfall/UI/StarfallTheme.uss" />
    <ui:Style src="project://database/Assets/Starfall/UI/Station.uss" />
    <ui:VisualElement class="screen station-ui">
        <ui:VisualElement class="station-header panel">
            <ui:VisualElement>
                <ui:Label name="station-title" text="HELIOS PRIME ORBITAL" class="title station-title" />
                <ui:Label name="pilot-summary" text="Pilot · Acolyte · 50,000 ISK" class="muted" />
            </ui:VisualElement>
            <ui:VisualElement class="header-spacer" />
            <ui:Button name="settings" text="SETTINGS" />
            <ui:Button name="repair" text="REPAIR" />
            <ui:Button name="save" text="SAVE" />
            <ui:Button name="undock" text="UNDOCK" class="undock" />
        </ui:VisualElement>
        <ui:VisualElement class="station-services panel">
            <ui:VisualElement class="tabbar">
                <ui:Button name="tab-agents" text="AGENTS" class="active" />
                <ui:Button name="tab-market" text="MARKET" />
                <ui:Button name="tab-fitting" text="FITTING" />
                <ui:Button name="tab-ships" text="SHIPS" />
                <ui:Button name="tab-skills" text="SKILLS" />
                <ui:Button name="tab-lp" text="LP STORE" />
            </ui:VisualElement>
            <ui:VisualElement name="panel-agents" class="service-panel"><ui:Label text="AVAILABLE AGENTS" class="eyebrow" /><ui:ScrollView name="agents-list" /></ui:VisualElement>
            <ui:VisualElement name="panel-market" class="service-panel"><ui:Label text="REGIONAL MARKET" class="eyebrow" /><ui:ScrollView name="market-list" /></ui:VisualElement>
            <ui:VisualElement name="panel-fitting" class="service-panel"><ui:Label text="FITTING &amp; HANGAR INVENTORY" class="eyebrow" /><ui:ScrollView name="fitting-list" /></ui:VisualElement>
            <ui:VisualElement name="panel-ships" class="service-panel"><ui:Label text="ACTIVE SHIPS" class="eyebrow" /><ui:ScrollView name="ships-list" /></ui:VisualElement>
            <ui:VisualElement name="panel-skills" class="service-panel"><ui:Label text="SKILL TRAINING" class="eyebrow" /><ui:ScrollView name="skills-list" /></ui:VisualElement>
            <ui:VisualElement name="panel-lp" class="service-panel"><ui:Label text="LOYALTY STORE" class="eyebrow" /><ui:Label name="lp-summary" text="Available loyalty points: 0" /><ui:Button name="lp-exchange" text="EXCHANGE 100 LP FOR DAMAGE AMP" /></ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="STATION SERVICES ONLINE · PRESS UNDOCK TO RETURN TO SPACE" class="station-footer muted panel" />
    </ui:VisualElement>
</ui:UXML>
