.station-header { position: absolute; left: 18px; right: 18px; top: 14px; height: 72px; flex-direction: row; align-items: center; }
.station-title { font-size: 23px; -unity-text-align: middle-left; }
.header-spacer { flex-grow: 1; }
.station-header Button { width: 104px; margin-left: 7px; }
.station-header .undock { background-color: rgb(21, 103, 137); height: 42px; }
.station-services { position: absolute; right: 18px; top: 104px; bottom: 54px; width: 480px; max-width: 92%; }
.tabbar { flex-direction: row; }
/* Six tabs share 480px; without nowrap+ellipsis "LP STORE" would wrap or
   overflow its button on English UIs. */
.tabbar Button {
    flex-grow: 1;
    font-size: 14px;
    margin-right: 3px;
    padding-left: 2px;
    padding-right: 2px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}
.service-panel { flex-grow: 1; margin-top: 12px; }
.service-panel ScrollView { flex-grow: 1; margin-top: 8px; }
.station-footer { position: absolute; left: 18px; right: 18px; bottom: 12px; height: 34px; -unity-text-align: middle-center; font-size: 13px; }

/* ---- compact layout: foldable / small screens (class toggled by StarfallResponsiveUi) ---- */
.hud-compact .station-header { left: 10px; right: 10px; top: 8px; height: 60px; }
.hud-compact .station-title { font-size: 18px; }
.hud-compact .station-header Button { width: 84px; }
.hud-compact .station-services { right: 10px; top: 76px; bottom: 44px; width: 400px; }
.hud-compact .tabbar Button { font-size: 11px; letter-spacing: 0; margin-right: 2px; }
.hud-compact .station-footer { left: 10px; right: 10px; font-size: 11px; }
