:root {
    --bg: rgba(3, 8, 20, 0.92);
    --panel: rgba(7, 18, 38, 0.91);
    --line: rgba(67, 190, 235, 0.38);
    --cyan: rgb(82, 224, 255);
    --text: rgb(210, 232, 244);
    --muted: rgb(116, 151, 177);
    --danger: rgb(255, 76, 82);
}

* {
    color: var(--text);
    -unity-font-definition: url("/Assets/Starfall/Fonts/Rajdhani/Rajdhani-SemiBold.ttf");
    font-size: 16px;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.panel {
    background-color: var(--panel);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--line);
    border-right-color: var(--line);
    border-top-color: var(--line);
    border-bottom-color: var(--line);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    padding: 12px;
}

.title {
    -unity-font-definition: url("/Assets/Starfall/Fonts/Orbitron/Orbitron-VariableFont_wght.ttf");
    color: var(--cyan);
    letter-spacing: 4px;
    font-size: 38px;
    -unity-text-align: middle-center;
}

.eyebrow {
    color: var(--cyan);
    letter-spacing: 2px;
    font-size: 13px;
}

Button {
    background-color: rgba(11, 38, 65, 0.92);
    border-left-color: rgba(84, 214, 255, 0.55);
    border-right-color: rgba(84, 214, 255, 0.55);
    border-top-color: rgba(84, 214, 255, 0.55);
    border-bottom-color: rgba(84, 214, 255, 0.55);
    color: var(--text);
    min-height: 44px;
    transition-duration: 0.12s;
}

Button:hover, Button.active, Button.chosen {
    background-color: rgba(26, 116, 151, 0.9);
    color: white;
}

.muted { color: var(--muted); }
.danger { color: var(--danger); }
.hidden { display: none; }

.bar-track {
    height: 9px;
    margin-top: 4px;
    background-color: rgba(1, 5, 12, 0.88);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.bar-fill { height: 9px; }
.shield { background-color: rgb(55, 154, 255); }
.armor { background-color: rgb(233, 162, 72); }
.hull { background-color: rgb(212, 67, 68); }

.service-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 48px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(72, 156, 190, 0.23);
}

.service-row Label { flex-grow: 1; }
.service-row Button { width: 120px; }

.settings-overlay {
    display: none;
    background-color: rgba(0, 3, 12, 0.84);
    align-items: center;
    justify-content: center;
}

.settings-card {
    width: 440px;
    max-width: 92%;
    padding: 20px;
}

.settings-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

#settings-title {
    -unity-font-definition: url("/Assets/Starfall/Fonts/Orbitron/Orbitron-VariableFont_wght.ttf");
    color: var(--cyan);
    letter-spacing: 3px;
    font-size: 25px;
}

#settings-display-heading,
#settings-language-heading,
#settings-audio-heading {
    color: var(--cyan);
    letter-spacing: 2px;
    font-size: 13px;
    margin-top: 8px;
    margin-bottom: 6px;
}

.settings-control {
    margin-bottom: 12px;
}

.settings-volume-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.settings-slider {
    flex-grow: 1;
}

.settings-value {
    width: 48px;
    margin-left: 10px;
    -unity-text-align: middle-right;
    color: var(--cyan);
}

#settings-footer {
    color: var(--muted);
    margin-top: 8px;
    font-size: 13px;
}

/* Chinese locale: Orbitron/Rajdhani carry no CJK glyphs, so swap the whole
   document to Noto Sans SC. Placed last and with specificity that beats both
   the global "*" rule and ".title" so every element flips together with the
   "lang-zh" class toggled by UiLocalizer.Apply. */
.lang-zh * {
    -unity-font-definition: url("/Assets/Starfall/Fonts/NotoSansSC/NotoSansSC-Regular.ttf");
}

.lang-zh .title,
.lang-zh #settings-title {
    -unity-font-definition: url("/Assets/Starfall/Fonts/NotoSansSC/NotoSansSC-Bold.ttf");
    letter-spacing: 2px;
}

.lang-zh .eyebrow {
    letter-spacing: 1px;
}

.lang-zh Button {
    font-size: 15px;
}

/* ---- compact visual tuning (foldable / small screens; class toggled by StarfallResponsiveUi) ----
   Lighter panel fill + fainter borders so HUD panels read as translucent overlays
   over the star field, in the spirit of EVE Echoes. */
.hud-compact {
    --panel: rgba(6, 14, 30, 0.78);
    --line: rgba(67, 190, 235, 0.30);
}
.hud-compact .service-row { min-height: 48px; }
